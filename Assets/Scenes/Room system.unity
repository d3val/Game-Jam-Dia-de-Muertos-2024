    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[0].dialogueText
      value: "Saludos humano. Te tengo una pregunta. \xBFSabes en donde est\xE1s?"
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[1].dialogueText
      value: "Conozco este camino mejor que tu, as\xED que escucha mi consejo: Sigue
        a tu amigo canino, \xE9l te guiar\xE1 por el camino."
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: secondaryDialogues.Array.data[0].dialogueText
      value: "\xBFTe perdiste? Mira con detalle amigo. Seguro encuentras tu camino."
      objectReference: {fileID: 0}
