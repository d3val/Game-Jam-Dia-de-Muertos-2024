      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[0].dialogueText
      value: "Hay algo que siempre quise olvidar, pero lo olvid\xE9 de nuevo...\r"
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[1].dialogueText
      value: "Oye, tu. \xBFQu\xE9 deseas olvidar?"
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[2].dialogueText
      value: "Lo \xFAnico que no dejo de recordar es que para salir de aqu\xED, la
        segunda puerta es la de ABAJO."
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[3].dialogueText
      value: "Cierro el libro, apago la luz,\r\nsin distinci\xF3n de rey o de cruz. "
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[4].dialogueText
      value: "\xBFTu sabes qu\xE9 es?."
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[5].dialogueText
      value: Por cierto...
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[6].dialogueText
      value: "Esuch\xE9 que para salir de aqu\xED primero tienes que ir para ARRIBA."
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: OnDialogueFirstEnd.m_PersistentCalls.m_Calls.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7354769210824661288, guid: 5269a71fab36b324686430ea4726103b, type: 3}
      propertyPath: dialogues.Array.data[5].OnDialogueStart.m_PersistentCalls.m_Calls.Array.size
      value: 0
      objectReference: {fileID: 0}
